<?xml version="1.0" encoding="utf-8"?>
<!--
    IME metadata. This tells Android what subtypes (languages) the keyboard supports.
    Android will list this keyboard in Settings → Keyboard list.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.mathra.keyboard.dashboard.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <!-- English (QWERTY) -->
    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_en"
        android:isDefault="true"
        android:overridesImplicitlyEnabledSubtype="true" />

    <!-- Sinhala (Unicode) -->
    <subtype
        android:imeSubtypeLocale="si_LK"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_si"
        android:isDefault="false"
        android:overridesImplicitlyEnabledSubtype="false" />

    <!-- Singlish (phonetic → Sinhala) -->
    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_singlish"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=singlish"
        android:isDefault="false"
        android:overridesImplicitlyEnabledSubtype="false" />

</input-method>
