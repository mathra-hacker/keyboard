<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_dashboard.xml
  Premium dashboard with animated logo, status cards, and nav buttons.
  All background rendering done in XML; no custom view required.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ── Logo ────────────────────────────────────────── -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Mathra Keyboard Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATHRA"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/brand_cyan"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KEYBOARD"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.3"
            android:layout_marginBottom="24dp" />

        <!-- ── Status card ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keyboard Status"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_enable_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_status_disabled"
                android:textColor="@color/status_warn"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_select_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_status_not_selected"
                android:textColor="@color/status_warn"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ── Enable / Select buttons ────────────────────── -->
        <Button
            android:id="@+id/btn_enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_enable_keyboard"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_primary_gradient"
            android:layout_marginBottom="10dp"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_keyboard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_select_keyboard"
            android:textColor="@color/brand_cyan"
            android:background="@drawable/btn_outline"
            android:layout_marginBottom="24dp"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- ── Settings grid ──────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:layout_marginBottom="10dp" />

        <Button android:id="@+id/btn_themes"
            style="@style/DashboardBtn"
            android:text="🎨  Themes" />
        <Button android:id="@+id/btn_language"
            style="@style/DashboardBtn"
            android:text="⌨️  Language &amp; Typing" />
        <Button android:id="@+id/btn_emoji_settings"
            style="@style/DashboardBtn"
            android:text="😊  Emoji Settings" />
        <Button android:id="@+id/btn_ai_settings"
            style="@style/DashboardBtn"
            android:text="🤖  AI Assistant" />
        <Button android:id="@+id/btn_privacy"
            style="@style/DashboardBtn"
            android:text="🔒  Privacy Settings" />
        <Button android:id="@+id/btn_about"
            style="@style/DashboardBtn"
            android:text="ℹ️  About Mathra" />

    </LinearLayout>
</ScrollView>
